    "inclusive_career_hub" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclusive Career Hub"
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
