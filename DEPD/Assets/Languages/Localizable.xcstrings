    "i_herby_that" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I herby that all information provided in this complaint form is true and accurate to the best of my knowledge. I understand that providing false information may result in legal action against me."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مان چوان ٿو ته هن شڪايتي فارم ۾ ڏنل سموري معلومات منهنجي ڄاڻ جي لحاظ کان درست ۽ درست آهي. مان سمجهان ٿو ته غلط معلومات مهيا ڪرڻ جي نتيجي ۾ منهنجي خلاف قانوني ڪارروائي ٿي سگهي ٿي."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میں بتاتا ہوں کہ شکایت کے اس فارم میں فراہم کردہ تمام معلومات میری بہترین معلومات کے مطابق درست اور درست ہیں۔ میں سمجھتا ہوں کہ غلط معلومات فراہم کرنے کے نتیجے میں میرے خلاف قانونی کارروائی ہو سکتی ہے۔"
          }
        }
      }
    },
    "if_the_complainant" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
